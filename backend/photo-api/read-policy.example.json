{
  "Version": "2012-10-17",
  "Statement": [{
    "Sid": "ReadMainPhotoAlbum",
    "Effect": "Allow",
    "Action": "dynamodb:Query",
    "Resource": "arn:aws:dynamodb:ap-northeast-1:YOUR_ACCOUNT_ID:table/cj-photo-catalog",
    "Condition": { "ForAllValues:StringEquals": { "dynamodb:LeadingKeys": ["ALBUM#main"] } }
  }]
}
